# Copy this file to Tests/.env to enable functional tests against a real
# S3/MinIO endpoint. Tests/.env is gitignored — keep credentials out of VCS.
#
# Required:
FAL_S3_TEST_BUCKET=fal-s3-test
FAL_S3_TEST_KEY=
FAL_S3_TEST_SECRET=
FAL_S3_TEST_REGION=us-east-1

# Optional — set when targeting MinIO or any S3-compatible endpoint:
#FAL_S3_TEST_ENDPOINT=http://minio:9000
#FAL_S3_TEST_USE_PATH_STYLE=1
#FAL_S3_TEST_PUBLIC_BASE_URL=https://cdn.example.com

# Optional — basePath inside the bucket. Useful to namespace test artefacts:
#FAL_S3_TEST_BASE_PATH=/test-fixtures/